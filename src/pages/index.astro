---
/**
 * ------------------------------------------------------------
 * トップページです。
 * 今回は植物一覧そのものをトップでも見せる構成にしつつ、
 * 一覧 UI 本体は components 側へ切り出しています。
 * また、導入文は共通ファイルから読み込むようにして、
 * index.astro が複数あっても文言の整合性が崩れないようにしています。
 * ------------------------------------------------------------
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import PlantArchive from '../components/PlantArchive.astro';
import { getAllPlants } from '../lib/plants';
import { getArchiveIntro } from '../lib/siteContent';

// 植物一覧を取得します。
const plants = getAllPlants();

// CMS で管理している共通の導入文を取得します。
const archiveIntro = getArchiveIntro();
---

<BaseLayout
  title="Bikakushida"
  description="ビカクシダの育成記録サイト"
  count={plants.length}
  canonicalPath="/"
>
  <PlantArchive
    plants={plants}
    introTitle={archiveIntro.archiveIntroTitle}
    introText={archiveIntro.archiveIntroText}
  />
</BaseLayout>
